# Primus credentials are server-side only. Create them at https://dev.primuslabs.xyz/
ZKTLS_APP_ID=
ZKTLS_APP_SECRET=

# Local server port
PORT=8787

# Optional: restrict browser origins in production, comma-separated.
# Leave blank for same-origin local development.
ALLOWED_ORIGINS=

# Optional public Primus template ID used to prefill the wallet zkTLS panel.
# This is a template identifier, not a secret. It can also be entered in the UI.
VITE_PRIMUS_WALLET_TEMPLATE_ID=
