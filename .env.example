# Primus Developer Hub credentials.
# Keep both values private. In Cloudflare, add them as encrypted Worker secrets.
# The App ID is returned to the browser; the App Secret is used only by the server to sign requests.
ZKTLS_APP_ID=
ZKTLS_APP_SECRET=

# Local Express server port
PORT=8787

# Optional: restrict browser origins in production, comma-separated.
# Leave blank for same-origin local development.
ALLOWED_ORIGINS=
